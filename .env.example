# ========================================================
# Muhsin App — Environment Variables Example (Root)
# Salin file ini menjadi `.env` di root server VPS:
# cp .env.example .env
# ========================================================

# 1. DATABASE (PostgreSQL)
DB_USER=muhsin_admin
DB_PASSWORD=GantiPasswordPostgresKuat123!
DB_NAME=muhsin_db

# 2. JWT SECURITY (Minimal 32 karakter acak & unik)
JWT_SECRET=ganti-dengan-access-token-secret-min-32-karakter-acak!
JWT_REFRESH_SECRET=ganti-dengan-refresh-token-secret-min-32-karakter-acak!

# 3. WEB PUSH NOTIFICATION (VAPID)
# Buat key baru dengan: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@muhsin.id

# 4. FRONTEND BUILD CONFIGURATION (Vite)
# URL publik API yang diakses oleh browser/HP user (gunakan HTTPS)
VITE_API_URL=https://api.muhsin.id
VITE_DEFAULT_SCHOOL_SLUG=alfitrah
