{
  "name": "@muhsin/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "start": "bun run src/index.ts",
    "build": "bun build src/index.ts --outdir ./dist --target bun",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:create": "bun run src/db/manage-db.ts create",
    "db:reset": "bun run src/db/manage-db.ts reset && bun run db:migrate",
    "db:seed": "bun run src/db/seed.ts",
    "db:seed:sim": "bun run src/db/seed-simulation.ts",
    "db:purge-views": "bun run src/db/purge-parent-views.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@muhsin/shared": "workspace:*",
    "@node-rs/argon2": "^1.8.0",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.12",
    "ioredis": "^5.4.1",
    "jose": "^5.9.0",
    "postgres": "^3.4.4",
    "web-push": "^3.6.7",
    "exceljs": "^4.4.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bun": "^1.1.10",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.6.2",
    "vitest": "^4.1.11"
  }
}
